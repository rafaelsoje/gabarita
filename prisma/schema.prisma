generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String         @unique
  avatarUrl      String?
  phone          String?
  birthDate      DateTime?
  city           String?
  state          String?
  openAiEmail    String?
  openAiApiKey   String?
  openAiModel    String?
  llmProvider    String?
  notifyEmailEnabled      Boolean        @default(false)
  notifyTelegramEnabled   Boolean        @default(false)
  notifyDiscordEnabled    Boolean        @default(false)
  notifyTelegramBotToken  String?
  notifyTelegramChatId    String?
  notifyDiscordWebhookUrl String?
  notifyDailySentAt       DateTime?
  notifyConcursosEnabled  Boolean        @default(true)
  notifyConcursosRegions  String[]       @default(["ALL", "NACIONAL"])
  notifyConcursosNotifiedOpen    String[] @default([])
  notifyConcursosNotifiedLastDay String[] @default([])
  passwordHash   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  plans          Plan[]
  studySessions  StudySession[]
  questions      Question[]
  questionResponses QuestionResponse[]
  mockExams      MockExam[]
  mockExamAttempts MockExamAttempt[]
  boardProfiles  ExamBoardProfile[]
  studyPlanConfigs PlanStudyPlanConfig[]
  studyPlanDays  PlanStudyPlanDay[]
  reviewSchedules TopicReviewSchedule[]
}

model ExamBoardProfile {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  style          ExamBoardStyle @default(MULTIPLE_CHOICE_5)
  styles         ExamBoardStyle[] @default([])
  instructions   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, normalizedName])
  @@index([normalizedName])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Plan {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  isArchived          Boolean        @default(false)
  archivedAt          DateTime?
  imageUrl            String?
  examDate            DateTime?
  notes               String?
  studyWeekdayMinutes Int            @default(120)
  studyWeekendMinutes Int            @default(180)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subjects            Subject[]
  cycleItems          PlanCycleItem[]
  studySessions       StudySession[]
  referenceLinks      PlanReferenceLink[]
  referenceFiles      PlanReferenceFile[]
  questions           Question[]
  mockExams           MockExam[]
  studyPlanConfig     PlanStudyPlanConfig?
  studyPlanDays       PlanStudyPlanDay[]

  @@index([userId])
}

model Subject {
  id             String         @id @default(cuid())
  planId         String
  plan           Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  importance     Int            @default(3)
  knowledgeLevel Int            @default(50)
  position       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  topics         Topic[]
  cycleItems     PlanCycleItem[]
  studySessions  StudySession[]
  questions      Question[]

  @@index([planId])
}

model PlanCycleItem {
  id             String   @id @default(cuid())
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  plannedMinutes  Int      @default(60)
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([planId, subjectId])
  @@index([planId, position])
  @@index([subjectId])
}

model Topic {
  id            String         @id @default(cuid())
  subjectId      String
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TopicStatus    @default(PENDING)
  position       Int            @default(0)
  estimatedMinutes Int?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  studySessions  StudySession[]
  attachments    TopicAttachment[]
  questions      Question[]
  reviewSchedules TopicReviewSchedule[]

  @@index([subjectId])
  @@index([status])
}

model TopicAttachment {
  id           String   @id @default(cuid())
  topicId       String
  topic         Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  originalName  String
  fileName      String
  fileUrl       String
  mimeType      String
  sizeBytes     Int
  scanStatus    AttachmentScanStatus @default(CLEAN)
  scannedAt     DateTime?
  scanResult    String?
  createdAt     DateTime @default(now())

  @@index([topicId, createdAt])
  @@index([scanStatus, createdAt])
}

model PlanReferenceLink {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, createdAt])
}

model PlanReferenceFile {
  id           String               @id @default(cuid())
  planId       String
  plan         Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  originalName String
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  scanStatus   AttachmentScanStatus @default(CLEAN)
  scannedAt    DateTime?
  scanResult   String?
  createdAt    DateTime             @default(now())

  @@index([planId, createdAt])
  @@index([scanStatus, createdAt])
}

model StudySession {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String?
  plan             Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  subjectId        String?
  subject          Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId          String?
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  category         StudyCategory     @default(THEORY)
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  durationMinutes  Int               @default(0)
  questionsCorrect Int               @default(0)
  questionsWrong   Int               @default(0)
  questionsBlank   Int               @default(0)
  pagesRead        Int               @default(0)
  videoMinutes     Int               @default(0)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, startedAt])
  @@index([planId])
  @@index([subjectId])
  @@index([topicId])
}

model PlanStudyPlanConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String   @unique
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model PlanStudyPlanDay {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  date             DateTime
  weekdayLabel     String
  subjectId        String?
  subjectName      String
  topicId          String?
  topicTitle       String?
  plannedMinutes   Int      @default(0)
  questionsTarget  Int      @default(0)
  reviewsTarget    Int      @default(0)
  mockExamsTarget  Int      @default(0)
  source           String   @default("FALLBACK")
  llmModel         String?
  position         Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, date])
  @@index([planId, date, position])
}

model TopicReviewSchedule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lastStudyAt  DateTime
  nextReviewAt DateTime
  reviewCount  Int      @default(0)
  intervalDays Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId, nextReviewAt])
  @@index([topicId, nextReviewAt])
}

model Question {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String?
  plan        Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  subjectId   String?
  subject     Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId     String?
  topic       Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subjectLabel String?
  topicLabel   String?
  theme        String?
  keywords     String[]          @default([])
  banca       String?
  statement   String
  explanation String?
  whyCorrect  String?
  whyWrong    String?
  difficulty  QuestionDifficulty @default(MEDIUM)
  sourceType  QuestionSourceType @default(GENERATED)
  llmModel    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  options     QuestionOption[]
  responses   QuestionResponse[]
  mockItems   MockExamItem[]

  @@index([userId, createdAt])
  @@index([planId])
  @@index([subjectId])
  @@index([topicId])
  @@index([subjectLabel])
  @@index([topicLabel])
  @@index([theme])
}

model QuestionOption {
  id            String   @id @default(cuid())
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label         String
  text          String
  isCorrect     Boolean  @default(false)
  optionComment String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  responses     QuestionResponse[]

  @@unique([questionId, label])
  @@index([questionId, position])
}

model QuestionResponse {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId  String?
  selectedOption    QuestionOption?         @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect         Boolean
  context           QuestionResponseContext @default(PRACTICE)
  mockExamAttemptId String?
  mockExamAttempt   MockExamAttempt?        @relation(fields: [mockExamAttemptId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([mockExamAttemptId])
}

model MockExam {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String?
  plan       Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  title      String?
  durationMinutes Int?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  items      MockExamItem[]
  attempts   MockExamAttempt[]

  @@index([userId, createdAt])
  @@index([planId])
}

model MockExamItem {
  id         String   @id @default(cuid())
  mockExamId String
  mockExam   MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([mockExamId, questionId])
  @@index([mockExamId, position])
  @@index([questionId])
}

model MockExamAttempt {
  id           String             @id @default(cuid())
  mockExamId   String
  mockExam     MockExam           @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt    DateTime           @default(now())
  finishedAt   DateTime           @default(now())
  correctCount Int                @default(0)
  wrongCount   Int                @default(0)
  blankCount   Int                @default(0)
  scorePct     Int                @default(0)
  responses    QuestionResponse[]

  @@index([mockExamId, finishedAt])
  @@index([userId, finishedAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ConcursoListing {
  id                 String         @id @default(cuid())
  source             String
  externalId         String
  title              String
  organization       String
  state              String?
  scope              String?
  status             ConcursoStatus
  registrationStart  DateTime?
  registrationEnd    DateTime?
  expectedNoticeDate DateTime?
  officialUrl        String?
  sourceUrl          String?
  summary            String?
  raw                Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([source, externalId])
  @@index([status, state])
  @@index([updatedAt])
}

enum TopicStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum StudyCategory {
  THEORY
  PRACTICE
  REVIEW
  MOCK_EXAM
}

enum AttachmentScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  ERROR
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSourceType {
  GENERATED
  MANUAL
  IMPORTED
}

enum QuestionResponseContext {
  PRACTICE
  MOCK_EXAM
}

enum ExamBoardStyle {
  MULTIPLE_CHOICE_5
  MULTIPLE_CHOICE_4
  MULTIPLE_CHOICE_EXCEPT_5
  TRUE_FALSE_2
  ORDERING_SEQUENCE_5
  ASSOCIATION_COLUMNS_5
  ASSERTION_COMBINATION_5
  ASSERTION_REASON_5
  MULTI_SELECT_COMBINATION_5
  GAP_FILLING_COMBINATION_5
  CASE_STUDY_OBJECTIVE_5
}

enum ConcursoStatus {
  OPEN
  PLANNED
}
