# URL de conexão do PostgreSQL (Prisma).
# Formato: postgresql://usuario:senha@host:porta/database?schema=public
DATABASE_URL="postgresql://usuario:senha@host:porta/database?schema=public"

# Segredo do JWT de acesso (curta duração). Use string longa e aleatória.
JWT_ACCESS_SECRET="troque-para-um-segredo-forte-access"

# Segredo do JWT de refresh (renovação de sessão). Deve ser diferente do access.
JWT_REFRESH_SECRET="troque-para-um-segredo-forte-refresh"

# URL pública da aplicação (usada em links e callbacks).
# Ex.: http://localhost:3000 (dev) | https://seu-dominio.com (produção)
APP_URL="http://localhost:3000"

# Controle de segurança para ambiente de desenvolvimento:
# - false (recomendado): nunca retorna resetToken na API de recuperação de senha
# - true: permite retorno do resetToken apenas fora de produção para testes locais
ALLOW_RESET_TOKEN_IN_RESPONSE="false"

# Driver do rate limit:
# - auto: usa Upstash se configurado; senão usa Postgres
# - postgres: usa apenas tabela no banco local
# - upstash: usa apenas Upstash Redis REST
# - memory: apenas memória do processo (bom para dev local)
RATE_LIMIT_DRIVER="auto"

# Multiplicador dos limites de mutação (plans/subjects/topics/sessions/uploads).
# Ex.: 1 = padrão (produção), 2 = tolerância maior (dev).
# Se vazio: usa 1 em produção e 2 em desenvolvimento.
MUTATION_RATE_LIMIT_MULTIPLIER=""

# Quando true, o backend confia em headers de proxy (x-forwarded-for/x-real-ip) para rate limit.
# Use true apenas atrás de proxy reverso confiável.
TRUST_PROXY="false"

# Chave usada para criptografar segredos sensíveis no banco (API keys, chat IDs, webhooks).
# Recomenda-se string longa e aleatória.
# Obrigatória para salvar preferências sensíveis (LLM/Telegram/Discord).
SECRETS_ENCRYPTION_KEY=""

# Ativa pipeline de varredura de anexos.
# false: anexos são marcados como CLEAN automaticamente (sem depender de ClamAV).
# true: anexos novos ficam PENDING e devem ser processados pelo worker scan:attachments.
ENABLE_ATTACHMENT_SCAN="false"

# Quando true e scan ativo, somente anexos CLEAN podem ser baixados/visualizados.
# Recomendado true em produção com worker funcionando.
ENFORCE_CLEAN_ATTACHMENT_ACCESS="false"

# Comando do scanner (ClamAV).
# Ex.: clamdscan (recomendado) ou clamscan
ATTACHMENT_SCAN_COMMAND="clamdscan"

# Argumentos padrão para o comando de scan.
ATTACHMENT_SCAN_ARGS="--no-summary"

# Quantos anexos processar por ciclo do worker.
ATTACHMENT_SCAN_BATCH_SIZE="20"

# Intervalo do worker em modo watch (ms) quando não há itens pendentes.
ATTACHMENT_SCAN_INTERVAL_MS="30000"

# Remove arquivo físico quando detectado INFECTED.
ATTACHMENT_DELETE_INFECTED="true"

# Upstash Redis REST URL (obrigatória quando RATE_LIMIT_DRIVER=upstash).
# Em auto, se preenchida junto com o token, terá prioridade sobre postgres.
UPSTASH_REDIS_REST_URL=""

# Upstash Redis REST TOKEN (obrigatória quando RATE_LIMIT_DRIVER=upstash).
# Nunca versionar este valor no Git.
UPSTASH_REDIS_REST_TOKEN=""

# Chave da API OpenAI (opcional).
# Se vazio e OLLAMA_BASE_URL estiver configurada, o sistema usa Ollama por padrão.
OPENAI_API_KEY=""

# Modelo da OpenAI usado na geração quando OPENAI_API_KEY estiver preenchida.
OPENAI_MODEL="gpt-5-mini"

# Endpoint da API Responses (opcional, útil para proxy compatível OpenAI).
OPENAI_RESPONSES_URL="https://api.openai.com/v1/responses"

# Ollama (fallback padrão quando não houver OpenAI API key).
# Exemplo local: http://127.0.0.1:11434
# Exemplo VPS: http://SEU_IP_OU_HOST:11434
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.1:8b"

# SMTP para envio opcional de notificações por e-mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Telegram Bot API (opcional): token global de fallback.
# Se cada usuário configurar seu próprio token em Preferências, esse valor não é necessário.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_API_BASE="https://api.telegram.org"

# Feed/API opcional para monitoramento de concursos.
# Espera JSON em array ou { items: [...] } com campos como:
# title/titulo, organization/orgao, state/estado, status/situacao, officialUrl/urlOficial.
# Pode conter {uf} para substituir pela UF selecionada na tela.
CONCURSOS_FEED_URL=""

# Lista opcional de múltiplas fontes (separadas por vírgula). Prioridade sobre CONCURSOS_FEED_URL.
# Exemplo:
# CONCURSOS_FEED_URLS="https://concursos-api.deno.dev/{uf},https://outra-fonte.com/api/concursos?uf={uf}"
CONCURSOS_FEED_URLS=""

# Template padrão quando CONCURSOS_FEED_URL e CONCURSOS_FEED_URLS estiverem vazios.
# Obs.: por padrão o sistema tenta PCI Concursos primeiro e este template como fallback.
CONCURSOS_FEED_TEMPLATE="https://concursos-api.deno.dev/{uf}"

# Token Bearer opcional para autenticação no feed.
CONCURSOS_FEED_TOKEN=""

# Janela de atualização (em minutos).
# Se já houver dados no banco para a UF e ainda estiverem dentro desse tempo,
# o sistema NÃO chama a API novamente.
CONCURSOS_REFRESH_MINUTES="360"
